{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fabric Origin Data APIs Entertainment Videos API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Ocp-Apim-Subscription-Key",
      "value": "{{Ocp-Apim-Subscription-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Videos",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a video by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.origin.fabricdata.com/api/Videos/GetVideo/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a video by ID"
        },
        {
          "info": {
            "name": "Get closed captions for a video",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.origin.fabricdata.com/api/Videos/ClosedCaptions/:videoId",
            "params": [
              {
                "name": "videoId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get closed captions for a video"
        }
      ]
    }
  ],
  "bundled": true
}